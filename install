#!/bin/bash
# Install micro-watcher into the user's home directory.
#
# This is an interim installer: it copies the reviewed checkout and creates a
# launcher. It never downloads code, never uses sudo, and never edits shell
# startup files. Packaging (`pyproject.toml` + pipx) replaces it in M1.
set -euo pipefail

SRC_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PREFIX="${XDG_DATA_HOME:-$HOME/.local/share}/micro-watcher"
BIN_DIR="${XDG_BIN_HOME:-$HOME/.local/bin}"
LAUNCHER="$BIN_DIR/micro-watcher"
DATA_DIR="$HOME/.cache/Watcher"
GNOME_UUID="micro-watcher@alberto-caballero.github.io"
GNOME_EXT_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/gnome-shell/extensions/$GNOME_UUID"

if [ ! -d "$SRC_DIR/src/micro_watcher" ] || [ ! -f "$SRC_DIR/src/bin/micro-watcher" ]; then
    echo "Error: run ./install from a micro-watcher checkout." >&2
    echo "Expected to find src/micro_watcher and src/bin/micro-watcher under $SRC_DIR." >&2
    exit 1
fi

if ! command -v python3 >/dev/null 2>&1; then
    echo "Error: python3 is required but was not found on PATH." >&2
    exit 1
fi

echo "[*] Installing micro-watcher to $PREFIX"
mkdir -p "$PREFIX/micro_watcher" "$PREFIX/bin" "$BIN_DIR"
cp "$SRC_DIR"/src/micro_watcher/*.py "$PREFIX/micro_watcher/"
rm -rf "$PREFIX/micro_watcher/__pycache__"
cp "$SRC_DIR/src/bin/micro-watcher" "$PREFIX/bin/micro-watcher"
chmod 755 "$PREFIX/bin/micro-watcher"

cat > "$LAUNCHER" <<EOF
#!/bin/sh
exec python3 "$PREFIX/bin/micro-watcher" "\$@"
EOF
chmod 755 "$LAUNCHER"

# Legacy data location kept for compatibility until the storage migration.
mkdir -p "$DATA_DIR/daily_data" "$DATA_DIR/Analysis"

# GNOME Shell cannot expose the focused window to unprivileged processes.
# Install a small user-level extension that answers over the session bus.
if [ -d "$SRC_DIR/extensions/gnome" ] && command -v gnome-extensions >/dev/null 2>&1; then
    mkdir -p "$GNOME_EXT_DIR"
    cp "$SRC_DIR"/extensions/gnome/* "$GNOME_EXT_DIR"/
    gnome-extensions disable "$GNOME_UUID" >/dev/null 2>&1 || true
    if gnome-extensions enable "$GNOME_UUID" >/dev/null 2>&1; then
        echo "[✔] Installed and enabled the GNOME focus extension."
    else
        # A newly copied extension is not known to the running shell until it
        # restarts, so record it in GSettings for the next login.
        if command -v gsettings >/dev/null 2>&1 && python3 - "$GNOME_UUID" <<'PY'
import ast
import subprocess
import sys

uuid = sys.argv[1]
try:
    output = subprocess.check_output(
        ["gsettings", "get", "org.gnome.shell", "enabled-extensions"],
        text=True,
    )
    extensions = ast.literal_eval(output)
except Exception:
    sys.exit(1)

if uuid not in extensions:
    extensions.append(uuid)
    value = "[" + ", ".join(
        "'" + item.replace("\\", "\\\\").replace("'", "\\'") + "'"
        for item in extensions
    ) + "]"
    subprocess.check_call(
        ["gsettings", "set", "org.gnome.shell", "enabled-extensions", value]
    )
PY
        then
            echo "[✔] GNOME focus extension installed and queued for the next login."
            echo "    Log out and back in once to load it."
        else
            echo "[!] GNOME focus extension installed but not loaded yet."
            echo "    Log out and back in, then run: gnome-extensions enable $GNOME_UUID"
        fi
    fi
fi

if [ "${XDG_SESSION_TYPE:-}" = "wayland" ]; then
    case "${XDG_CURRENT_DESKTOP:-}" in
        *[Gg][Nn][Oo][Mm][Ee]*)
            echo "[✔] GNOME Wayland backend installed."
            echo "    If this is the first install, log out and back in so GNOME Shell loads the extension."
            ;;
        *)
            echo "[!] Wayland detected, but this build currently supports GNOME Wayland only."
            echo "    KDE and wlroots backends are planned; see agents/OUTLINE.md."
            ;;
    esac
else
    missing=""
    for tool in xdotool xprintidle xprop; do
        if ! command -v "$tool" >/dev/null 2>&1; then
            missing="$missing $tool"
        fi
    done
    if [ -n "$missing" ]; then
        echo "[!] Missing X11 tools:$missing"
        echo "    Install them with your package manager before starting the tracker."
    fi
fi

case ":$PATH:" in
    *":$BIN_DIR:"*) ;;
    *)
        echo "[!] $BIN_DIR is not on PATH. Add it to your shell configuration:"
        echo "    export PATH=\"$BIN_DIR:\$PATH\""
        ;;
esac

echo "[✔] Installed. Start tracking with: micro-watcher --start"
echo "    No startup files were modified and no root access was used."
