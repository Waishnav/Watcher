#!/bin/bash

echo "[INFO] Starting Watcher (Go version) installation..."
sleep 1

# --- Dependency Checks ---
echo "[INFO] Checking for required dependencies..."
missing_deps=false

if ! command -v xprintidle &> /dev/null; then
    echo "[ERROR] xprintidle could not be found. Please install it first."
    echo "        On Debian/Ubuntu: sudo apt-get install xprintidle"
    missing_deps=true
fi

if ! command -v xdotool &> /dev/null; then
    echo "[ERROR] xdotool could not be found. Please install it first."
    echo "        On Debian/Ubuntu: sudo apt-get install xdotool"
    missing_deps=true
fi

if ! command -v go &> /dev/null; then
    echo "[ERROR] Go (golang) could not be found. Please install it first."
    echo "        Follow instructions at https://golang.org/doc/install"
    missing_deps=true
fi

if [ "$missing_deps" = true ]; then
    echo "[FATAL] Required dependencies are missing. Please install them and re-run the script."
    exit 1
fi
echo "[INFO] All required dependencies found."
sleep 1

# --- Go Compilation ---
echo "[INFO] Compiling the Watcher Go application..."
if go build -o watcher main.go; then
    echo "[SUCCESS] Watcher compiled successfully."
else
    echo "[FATAL] Failed to compile Watcher. Please check Go installation and project integrity."
    exit 1
fi
sleep 1

# --- Binary Placement ---
echo "[INFO] Installing Watcher binary to /usr/local/bin/..."
if sudo cp ./watcher /usr/local/bin/watcher; then
    echo "[SUCCESS] Watcher binary copied to /usr/local/bin/watcher."
else
    echo "[FATAL] Failed to copy Watcher binary. sudo privileges might be required or /usr/local/bin is not writable."
    exit 1
fi

echo "[INFO] Making the binary executable..."
if sudo chmod +x /usr/local/bin/watcher; then
    echo "[SUCCESS] Watcher binary is now executable."
else
    echo "[FATAL] Failed to set executable permission on /usr/local/bin/watcher."
    exit 1
fi
sleep 1

# --- Cache Directory Creation ---
# The application itself will create daily_data and Analysis subdirectories.
# We only need to ensure the base directory exists.
echo "[INFO] Ensuring base cache directory exists at ~/.cache/Watcher..."
if mkdir -p ~/.cache/Watcher; then
    echo "[SUCCESS] Base cache directory ensured."
else
    echo "[WARNING] Could not create base cache directory ~/.cache/Watcher. The application might fail if it cannot create it either."
fi
sleep 1

# --- Auto-start (X11 specific - kept from original, user might need to adapt for Wayland/other DEs) ---
# This part is for X11 sessions using .xprofile.
# Users on Wayland or different desktop environments might need other autostart methods (e.g., systemd user services, .desktop files in ~/.config/autostart).
echo "[INFO] Setting up auto-start for X11 sessions (via .xprofile)..."
if [ -f "$HOME/.xprofile" ]; then
    # Check if watcher start command already exists
    if ! grep -q "watcher start &" "$HOME/.xprofile"; then
        echo "[INFO] Adding watcher to .xprofile for auto-start."
        echo "" >> "$HOME/.xprofile" # Add a newline for separation
        echo "# Start Watcher application" >> "$HOME/.xprofile"
        echo "watcher start &" >> "$HOME/.xprofile"
    else
        echo "[INFO] Watcher auto-start already configured in .xprofile."
    fi
else
    echo "[INFO] .xprofile not found. Creating and configuring for Watcher auto-start."
    echo "# Start Watcher application" > "$HOME/.xprofile"
    echo "watcher start &" >> "$HOME/.xprofile"
    echo "[INFO] Please ensure your display manager sources ~/.xprofile (e.g., by adding 'source ~/.xprofile' to ~/.xinitrc if using startx)."
fi
sleep 1

# --- Final Instructions ---
echo ""
echo "[SUCCESS] Watcher installation completed!"
echo "You can now use the 'watcher' command."
echo "Try 'watcher --help' for available commands."
echo "For the logging service to start automatically, you may need to restart your X session or reboot."
echo "Alternatively, you can start it manually now by running: watcher start"
echo ""
echo "If anything goes wrong, please open an issue or submit a PR at the project repository."

# Cleanup compiled binary from current directory if desired, as it's now in PATH
# rm ./watcher
# For testing, it's better to keep it to immediately verify.
# The user can remove the cloned/downloaded Watcher directory after installation.

exit 0
